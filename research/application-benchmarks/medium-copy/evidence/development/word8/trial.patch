+
+// copyDecimalDigits copies a non-overlapping coefficient span. Fixed-size
+// chunks let the compiler use word loads/stores without general copy dispatch.
+func copyDecimalDigits(dst, src []byte) {
+	dst = dst[:len(src)]
+	const chunk = 8
+	for len(src) >= chunk {
+		copy(dst[:chunk], src[:chunk])
+		dst = dst[chunk:]
+		src = src[chunk:]
+	}
+	for i, c := range src {
+		dst[i] = c
+	}
 }
 
