--- Arithmetic (clause 5.4.1) ---
1.50 + 1.25 = 2.75
1.50 - 1.25 = 0.25
1.50 * 1.25 = 1.8750
1.50 / 1.25 = 1.2
1 / 3 = 0.3333333333333333
1 / 3 = 0.3333333333333333333333333333333333 in decimal128
2.5 * 4 + 0.1 with one rounding = 10.1
Remainder(7, 2) = -1
Mod(7, 2) = 1

--- Comparisons (clause 5.11) ---
1.0 == 1.00: true
-0 == +0: true
NaN == NaN: false  NaN != NaN: true
NaN < 1: false  NaN > 1: false  NaN >= 1: false
-Inf < -9.999999999999999E+384: true

--- Conversions (clauses 5.4.2, 5.8, 5.12) ---
decimal64(12345678901234567) = 1.234567890123457e+16
decimal128(12345678901234567) = 12345678901234567
int64(2.75) = 2  int64(-2.75) = -2
decimal64(float64 0.1) = 0.1000000000000000
decimal128(float64 0.1) = 0.1000000000000000055511151231257827
float64(decimal64 0.1) = 0.1
decimal128(decimal64 1.50) = 1.50
decimal64(decimal128 1/3) = 0.3333333333333333
FormatDecimal(1.50) = "1.50", ParseDecimal("1.50") = 1.50, <nil>
%v %.1f %e of 1.50: 1.50 1.5 1.500000e+00
ParseDecimal("1e400"): strconv.ParseDecimal: parsing "1e400": value out of range

--- Quantize and SameQuantum (clauses 5.3.2, 5.7.3) ---
Quantize(2.675, 0.01) = 2.68
Quantize(2.665, 0.01) = 2.66
Quantize(2, 0.01) = 2.00
SameQuantum(1.0, 1.00): false
SameQuantum(2.17, 9.99): true
QuantizeMode(-2.665, 0.01, ToNearestEven) = -2.66
QuantizeMode(-2.665, 0.01, ToNearestAway) = -2.67
QuantizeMode(-2.665, 0.01, ToZero) = -2.66
QuantizeMode(-2.665, 0.01, ToPositiveInf) = -2.66
QuantizeMode(-2.665, 0.01, ToNegativeInf) = -2.67

--- Rounding to an integer (clause 5.9) and the other functions ---
x = 2.5: Trunc 2, Floor 2, Ceil 3, Round 3, RoundToEven 2
x = -2.5: Trunc -2, Floor -3, Ceil -2, Round -3, RoundToEven -2
x = 3.5: Trunc 3, Floor 3, Ceil 4, Round 4, RoundToEven 4
Reduce(1.500) = 1.5  Reduce(100) = 1e+02
Abs(-1.50) = 1.50  Copysign(1.50, -0) = -1.50
Dim(5, 3) = 2  Dim(3, 5) = 0
Signbit(-0): true  IsNaN(NaN): true  IsInf(-Inf, -1): true

--- min and max ---
min(3, 2.5, 7) = 2.5  max(3, 2.5, 7) = 7
max(1.0, 1) = 1.0

--- NaN propagation (clause 6.2) ---
NaN + 1 = NaN  payload 42
2 * NaN / 3 = NaN  payload 42
decimal128(NaN) payload 42
0 * Inf = NaN  payload 0

--- Signed zero and infinity (clauses 6.1, 6.3) ---
1 / 0 = +Inf  -1 / 0 = -Inf  1 / -0 = -Inf
-0 + -0 = -0  -0 + 0 = 0  0 * -1 = -0
Inf + 1 = +Inf  Inf - Inf = NaN  1 / Inf = 0e-398

--- Overflow and underflow (clauses 7.4, 7.5) ---
9.999999999999999E+384 * 10 = +Inf
decimal64(decimal128 1E+385) = +Inf
1E-383 / 10 = 1e-384
1E-398 / 2 = 0e-398  1E-398 / 10 = 0e-398

--- Added in IEEE 754-2019 ---
min(NaN, 1) = NaN  max(1, NaN) = NaN
min(0, -0) = -0  max(-0, 0) = 0
Quantum(1.50) = 0.01  Quantum(-5E+3) = 1e+03
Quantum(0.00) = 0.01  Quantum(-Inf) = +Inf
Quantize(2.675, Quantum(0.01)) = 2.68
Payload(NaNWithPayload(42)) = 42
Payload(1.5) = -1
NaNWithPayload(4.2E+1) = NaN  payload 42
NaNWithPayload(10^15 - 1) payload 999999999999999
NaNWithPayload(10^15) = 0  NaNWithPayload(4.2) = 0
NaNWithPayload[decimal128](10^15) payload 1000000000000000
SignalingNaNWithPayload(42) + 1 = NaN  payload 42
